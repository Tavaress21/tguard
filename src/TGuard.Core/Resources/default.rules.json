    "description_pt": "PowerShell com comando codificado em Base64 e/ou janela escondida",
    "score": 55,
    "strings": {
      "ps": {
        "regex": "powershell(\\.exe)?",
        "nocase": true
      },
      "enc": {
        "regex": "\\s-e(nc(odedcommand)?)?\\s+[A-Za-z0-9+/=]{40,}",
        "nocase": true
      },
      "hidden": {
        "regex": "-w(indowstyle)?\\s+h(idden)?\\b",
        "nocase": true
      },
      "bypass": {
        "regex": "-(ep|ex(ecutionpolicy)?)\\s+bypass",
        "nocase": true
      }
    },
    "condition": "ps and (enc or (hidden and bypass))",
    "filetypes": [
      "code"
    ]
  },
  {
