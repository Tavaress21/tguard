<UserControl x:Class="TGuard.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TGuard.App.Services">
    <ScrollViewer>
        <StackPanel Margin="36,32,36,32" MaxWidth="860" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Saved" Style="{StaticResource Label}" Foreground="{StaticResource Good}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{s:Tr set.save}" Click="Save_Click" />
                </StackPanel>
                <TextBlock Text="{s:Tr set.title}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{s:Tr set.section.protection}" Style="{StaticResource Caption}" Margin="4,0,0,8" />
            <Border Style="{StaticResource CardBorder}" Padding="22,6">
                <StackPanel>
                    <CheckBox x:Name="Realtime" Style="{StaticResource Switch}" Content="{s:Tr set.realtime}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="ProcessGuard" Style="{StaticResource Switch}" Content="{s:Tr set.processguard}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="UsbScan" Style="{StaticResource Switch}" Content="{s:Tr set.usb}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="Ransomware" Style="{StaticResource Switch}" Content="{s:Tr set.ransom}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="AutoQuarantine" Style="{StaticResource Switch}" Content="{s:Tr set.autoq}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" Content="{s:Tr set.autoupdate}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="AutoInstall" Style="{StaticResource Switch}" Content="{s:Tr set.autoinstall}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <StackPanel Margin="0,12">
                        <TextBlock Text="{s:Tr set.abusekey}" Style="{StaticResource Label}" FontFamily="{StaticResource Body}" />
                        <TextBlock Text="{s:Tr set.abusekey.note}" Style="{StaticResource Small}" Margin="0,2,0,8" />
                        <TextBox x:Name="AbuseKey" />
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource Line}" />
                    <DockPanel Margin="0,12">
                        <ComboBox x:Name="Hour" DockPanel.Dock="Right" Width="90" Margin="16,0,0,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="Scheduled" Style="{StaticResource Switch}" Content="{s:Tr set.scheduled}" />
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="Community" Style="{StaticResource Switch}" Content="{s:Tr set.community}" Margin="0,12" IsEnabled="False" />
                </StackPanel>
            </Border>

            <TextBlock Text="{s:Tr set.section.general}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <Border Style="{StaticResource CardBorder}" Padding="22,6">
                <StackPanel>
                    <DockPanel Margin="0,12">
                        <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="200" VerticalAlignment="Center">
                            <ComboBoxItem Tag="pt" Content="Português (Portugal)" />
                            <ComboBoxItem Tag="en" Content="English" />
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="{s:Tr set.language}" Style="{StaticResource Label}" FontFamily="{StaticResource Body}" />
                            <TextBlock Text="{s:Tr set.language.note}" Style="{StaticResource Small}" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="Notifications" Style="{StaticResource Switch}" Content="{s:Tr set.notify}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="Startup" Style="{StaticResource Switch}" Content="{s:Tr set.startup}" Margin="0,12" />
                </StackPanel>
            </Border>

            <TextBlock Text="{s:Tr set.section.email}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <Border Style="{StaticResource CardBorder}" Padding="22,6">
                <StackPanel>
                    <CheckBox x:Name="EmailOn" Style="{StaticResource Switch}" Content="{s:Tr set.email.on}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <TextBlock x:Name="EmailNone" Text="{s:Tr email.none}" Style="{StaticResource Small}" Margin="0,12" TextWrapping="Wrap" />
                    <ItemsControl x:Name="EmailAccounts">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,10">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{s:Tr email.remove}" Tag="{Binding Id}" Click="RemoveEmail_Click" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding User}" Style="{StaticResource Label}" FontFamily="{StaticResource Body}" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{StaticResource Line}" />
                    <Grid Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{s:Tr email.address}" Style="{StaticResource Small}" Margin="0,0,0,6" />
                        <TextBox x:Name="EmailUser" Grid.Row="1" />
                        <TextBlock Grid.Column="2" Text="{s:Tr email.password}" Style="{StaticResource Small}" Margin="0,0,0,6" />
                        <PasswordBox x:Name="EmailPassword" Grid.Row="1" Grid.Column="2" Height="38" Padding="10,0" VerticalContentAlignment="Center" BorderBrush="{StaticResource Line}" />
                        <TextBlock Grid.Row="2" Text="{s:Tr email.server}" Style="{StaticResource Small}" Margin="0,12,0,6" />
                        <TextBox x:Name="EmailHost" Grid.Row="3" />
                        <Button x:Name="AddEmailButton" Grid.Row="3" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{s:Tr email.add}" Click="AddEmail_Click" HorizontalAlignment="Left" />
                    </Grid>
                    <CheckBox x:Name="EmailMove" Style="{StaticResource Switch}" Content="{s:Tr email.move}" Margin="0,12" IsChecked="True" />
                    <TextBlock Text="{s:Tr email.note}" Style="{StaticResource Small}" Margin="0,0,0,14" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{s:Tr set.section.web}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <Border Style="{StaticResource CardBorder}" Padding="22,6">
                <DockPanel Margin="0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{s:Tr web.install}" Click="InstallWeb_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{s:Tr web.title}" Style="{StaticResource Label}" FontFamily="{StaticResource Body}" />
                        <TextBlock Text="{s:Tr web.note}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{s:Tr set.section.account}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <Border Style="{StaticResource CardBorder}" Padding="22,6">
                <StackPanel>
                    <DockPanel Margin="0,14">
                        <Button x:Name="LinkButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{s:Tr acc.link}" Click="Link_Click" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock x:Name="AccountTitle" Text="{s:Tr acc.none}" Style="{StaticResource Label}" FontFamily="{StaticResource Body}" />
                            <TextBlock x:Name="AccountNote" Text="{s:Tr acc.none.note}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="{StaticResource Line}" />
                    <CheckBox x:Name="UsageStats" Style="{StaticResource Switch}" Content="{s:Tr acc.stats}" Margin="0,12" />
                    <Border Height="1" Background="{StaticResource Line}" />
                    <WrapPanel Margin="0,14">
                        <Button Style="{StaticResource SmallButton}" Content="{s:Tr acc.help}" Click="Help_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SmallButton}" Content="{s:Tr acc.report}" Click="ReportScam_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SmallButton}" Content="{s:Tr acc.site}" Click="Site_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{s:Tr set.section.folders}" Style="{StaticResource Caption}" Margin="4,22,0,8" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{s:Tr set.folders}" Style="{StaticResource Label}" Margin="0,0,0,8" />
                    <TextBox x:Name="Folders" AcceptsReturn="True" MinHeight="96" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{s:Tr set.exclusions}" Style="{StaticResource Label}" Margin="0,18,0,8" />
                    <TextBox x:Name="Exclusions" AcceptsReturn="True" MinHeight="72" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="About" Style="{StaticResource Small}" Margin="4,22,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
