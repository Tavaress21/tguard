<UserControl x:Class="TGuard.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TGuard.App.Services">
    <ScrollViewer>
        <StackPanel Margin="36,32,36,32">
            <TextBlock Text="{s:Tr q.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{s:Tr q.sub}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22" />

            <Border Style="{StaticResource CardBorder}" Padding="22,10">
                <StackPanel>
                    <StackPanel x:Name="Empty" Margin="0,30" HorizontalAlignment="Center">
                        <Border Style="{StaticResource IconTile}" Width="54" Height="54" CornerRadius="27" Background="{StaticResource GoodSoft}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Good}" />
                        </Border>
                        <TextBlock Text="{s:Tr q.empty}" Style="{StaticResource Lead}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl x:Name="Items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BadSoft}" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource Bad}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" ToolTip="{Binding Reasons}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Threat}" Foreground="{StaticResource Bad}" FontFamily="{StaticResource BodySemi}" FontSize="12.5" Margin="0,1,0,0" />
                                            <TextBlock Style="{StaticResource Small}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <Run Text="{Binding When, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Size, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Path, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <Button Style="{StaticResource SmallButton}" Content="{s:Tr q.report}" Tag="{Binding}" Click="Report_Click" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource SmallButton}" Content="{s:Tr q.restore}" Tag="{Binding Id}" Click="Restore_Click" />
                                            <Button Style="{StaticResource DangerButton}" Content="{s:Tr q.delete}" Tag="{Binding Id}" Click="Delete_Click" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel x:Name="TrustedSection" Margin="0,26,0,0">
                <TextBlock Text="{s:Tr q.trusted}" Style="{StaticResource H2}" />
                <TextBlock Text="{s:Tr q.trusted.sub}" Style="{StaticResource Small}" FontSize="13" Margin="0,3,0,12" />
                <Border Style="{StaticResource CardBorder}" Padding="22,6">
                    <ItemsControl x:Name="Trusted">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource GoodSoft}" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource Good}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontFamily="Consolas" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource SmallButton}" Content="{s:Tr q.trusted.remove}" Tag="{Binding Sha256}" Click="Untrust_Click" Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
