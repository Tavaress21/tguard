<UserControl x:Class="TGuard.App.Views.CheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TGuard.App.Services">
    <ScrollViewer>
        <StackPanel Margin="36,32,36,32">
            <DockPanel Margin="0,0,0,22">
                <Button x:Name="RunButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{s:Tr check.run}" Click="Run_Click" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{s:Tr check.title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{s:Tr check.sub}" Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource CardBorder}" Padding="22,8">
                <StackPanel>
                    <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,10,0,6" />
                    <ItemsControl x:Name="Items">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Background}" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding Foreground}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontSize="13" Margin="0,2,0,0" />
                                            <Border Visibility="{Binding FixVisibility}" Background="{StaticResource RoyalSoft}" CornerRadius="8" Padding="10,7" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Fix}" Foreground="{StaticResource Royal}" FontFamily="{StaticResource BodySemi}" FontSize="12.5" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
