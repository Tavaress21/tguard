<UserControl x:Class="TGuard.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TGuard.App.Services">
    <ScrollViewer>
        <StackPanel Margin="36,32,36,32">
            <TextBlock Text="{s:Tr dash.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{s:Tr dash.sub}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22" />

            <Border Style="{StaticResource CardBorder}" Padding="26,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFF" Offset="0.45" />
                        <GradientStop x:Name="HeroTint" Color="#ECF8F0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="76" Height="76" Margin="0,0,22,0" VerticalAlignment="Center">
                        <Ellipse x:Name="HeroCircle" Fill="{StaticResource GoodSoft}" />
                        <Ellipse x:Name="HeroRing" Stroke="{StaticResource Good}" StrokeThickness="2" Margin="6" />
                        <TextBlock x:Name="HeroIcon" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource Good}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitle" Text="{s:Tr dash.protected}" FontFamily="{StaticResource BodySemi}" FontSize="22" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock x:Name="HeroSub" Text="{s:Tr dash.protected.sub}" Style="{StaticResource Lead}" Margin="0,5,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{s:Tr dash.checkpc}" Click="Check_Click" />
                        <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="QuickScan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock Text="{s:Tr dash.quickscan}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="-7,16,-7,0">
                <Border Style="{StaticResource CardBorder}" Margin="7" Padding="18">
                    <DockPanel>
                        <Border x:Name="RealtimeTile" DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Style="{StaticResource IconTile}" Background="{StaticResource GoodSoft}">
                            <TextBlock x:Name="RealtimeIcon" Text="&#xEA18;" Style="{StaticResource Icon}" Foreground="{StaticResource Good}" />
                        </Border>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{s:Tr dash.tile.realtime}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TileRealtime" Text="—" Style="{StaticResource Metric}" FontSize="19" Margin="0,2,0,0" />
                            <TextBlock x:Name="TileRealtimeSub" Style="{StaticResource Small}" FontSize="11.5" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="7" Padding="18">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Style="{StaticResource IconTile}" Background="{StaticResource BadSoft}">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Bad}" />
                        </Border>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{s:Tr dash.tile.threats}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TileThreats" Text="—" Style="{StaticResource Metric}" Margin="0,2,0,0" />
                            <TextBlock Text="{s:Tr dash.tile.threats.sub}" Style="{StaticResource Small}" FontSize="11.5" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="7" Padding="18">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Style="{StaticResource IconTile}" Background="{StaticResource WarnSoft}">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icon}" Foreground="{StaticResource Warn}" />
                        </Border>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{s:Tr dash.tile.quarantine}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TileQuarantine" Text="—" Style="{StaticResource Metric}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="7" Padding="18">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="10" Style="{StaticResource IconTile}">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" Foreground="{StaticResource Royal}" />
                        </Border>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{s:Tr dash.tile.lastscan}" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="TileLastScan" Text="—" Style="{StaticResource Metric}" FontSize="19" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorder}" Padding="22,20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{s:Tr dash.viewall}" Click="History_Click" />
                            <TextBlock Text="{s:Tr dash.recent}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="NoRecent" Text="{s:Tr dash.norecent}" Style="{StaticResource Lead}" Margin="0,8,0,0" />
                        <ItemsControl x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{Binding PillBackground}" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{Binding PillForeground}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Border Style="{StaticResource Pill}" Background="{Binding PillBackground}" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding VerdictLabel}" Style="{StaticResource PillText}" Foreground="{Binding PillForeground}" />
                                                </Border>
                                                <TextBlock Text="{Binding When}" Style="{StaticResource Small}" FontSize="11.5" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="22,20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{s:Tr dash.engine}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="EngineRules" Style="{StaticResource Label}" />
                            <TextBlock Text="{s:Tr dash.tile.rules}" Style="{StaticResource Lead}" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="EngineSignatures" Style="{StaticResource Label}" />
                            <TextBlock Text="{s:Tr dash.tile.signatures}" Style="{StaticResource Lead}" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="EngineMode" Style="{StaticResource Label}" />
                            <TextBlock Text="{s:Tr dash.mode}" Style="{StaticResource Lead}" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="EngineVersion" Style="{StaticResource Label}" />
                            <TextBlock Text="{s:Tr dash.version}" Style="{StaticResource Lead}" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="EngineBadUrls" Style="{StaticResource Label}" />
                            <TextBlock Text="{s:Tr dash.badurls}" Style="{StaticResource Lead}" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Line}" />
                        <DockPanel Margin="0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="EngineLastUpdate" Style="{StaticResource Label}" />
                            <TextBlock Text="{s:Tr dash.lastupdate}" Style="{StaticResource Lead}" />
                        </DockPanel>
                        <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="Update_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                                <TextBlock x:Name="UpdateButtonText" Text="{s:Tr dash.update}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
