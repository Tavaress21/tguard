<UserControl x:Class="TGuard.App.Views.ProtectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TGuard.App.Services">
    <ScrollViewer>
        <StackPanel Margin="36,32,36,32">
            <TextBlock Text="{s:Tr prot.title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{s:Tr prot.sub}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,22" />

            <ItemsControl x:Name="Modules">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Margin="-7,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="7" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource Royal}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="15.5" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" FontSize="13" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding StatusBackground}" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource PillText}" Foreground="{Binding StatusForeground}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
