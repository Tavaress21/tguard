<UserControl x:Class="TGuard.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:TGuard.App.Services">
    <Grid Margin="36,32,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <Border x:Name="OnlinePill" DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center">
                <TextBlock x:Name="OnlineText" Style="{StaticResource PillText}" />
            </Border>
            <StackPanel>
                <TextBlock Text="{s:Tr help.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{s:Tr help.sub}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border x:Name="StartCard" Style="{StaticResource CardBorder}" Padding="24,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{s:Tr help.start.title}" Style="{StaticResource Label}" FontSize="16" />
                    <TextBlock x:Name="StartNote" Text="{s:Tr help.start.note}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <StackPanel x:Name="StartForm">
                        <TextBlock Text="{s:Tr help.name}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <TextBox x:Name="NameBox" FontFamily="{StaticResource Body}" MaxLength="100" />
                        <TextBlock Text="{s:Tr help.email}" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                        <TextBox x:Name="EmailBox" FontFamily="{StaticResource Body}" MaxLength="255" />
                        <TextBlock Text="{s:Tr help.message}" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                        <TextBox x:Name="FirstMessage" FontFamily="{StaticResource Body}" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="{s:Tr help.start}" Click="Start_Click" Margin="0,0,10,0" />
                            <Button x:Name="StartRemoteButton" Style="{StaticResource SecondaryButton}" Content="{s:Tr help.remote}" Click="StartRemote_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="OfflinePanel" Visibility="Collapsed">
                        <Button Style="{StaticResource PrimaryButton}" Content="{s:Tr help.ticket}" Click="Ticket_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock x:Name="StartError" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="ChatCard" Style="{StaticResource CardBorder}" Padding="0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,14">
                        <DockPanel>
                            <Button x:Name="NewChatButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{s:Tr help.new}" Click="NewChat_Click" Visibility="Collapsed" />
                            <StackPanel>
                                <TextBlock x:Name="ChatTitle" Style="{StaticResource Label}" />
                                <TextBlock x:Name="ChatSub" Style="{StaticResource Small}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" Padding="18,12" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Messages">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="{Binding Align}" MaxWidth="460" Margin="0,5">
                                        <Border Background="{Binding Background}" CornerRadius="14" Padding="13,9">
                                            <TextBlock Text="{Binding Body}" Foreground="{Binding Foreground}" TextWrapping="Wrap" FontFamily="{StaticResource Body}" FontSize="13.5" />
                                        </Border>
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Small}" FontSize="11" HorizontalAlignment="{Binding Align}" Margin="4,3,4,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="Input" FontFamily="{StaticResource Body}" MaxLength="2000" AcceptsReturn="False" TextWrapping="Wrap" KeyDown="Input_KeyDown" />
                            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{s:Tr help.send}" Click="Send_Click" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <Border Style="{StaticResource CardBorder}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{s:Tr help.remote.title}" Style="{StaticResource Label}" />
                        <TextBlock Text="{s:Tr help.remote.note}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{s:Tr help.remote.steps}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Button x:Name="RemoteButton" Style="{StaticResource SecondaryButton}" Content="{s:Tr help.remote}" Click="Remote_Click" Margin="0,14,0,0" HorizontalAlignment="Left" Visibility="Collapsed" />
                        <Button Style="{StaticResource SmallButton}" Content="{s:Tr help.quickassist}" Click="QuickAssist_Click" Margin="0,10,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="20,18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{s:Tr help.other.title}" Style="{StaticResource Label}" />
                        <TextBlock Text="{s:Tr help.other.note}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <Button Style="{StaticResource SmallButton}" Content="{s:Tr help.ticket}" Click="Ticket_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
