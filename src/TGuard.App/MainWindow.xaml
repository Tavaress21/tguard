<Window x:Class="TGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:TGuard.App.Services"
        Title="TGuard" Width="1180" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}"
        FontFamily="{StaticResource Body}"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        Icon="pack://application:,,,/Assets/tguard.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid" Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="16,18,16,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,30">
                    <Image Source="pack://application:,,,/Assets/logo-256.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="TGuard" FontFamily="{StaticResource BodyBold}" FontSize="22" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,1" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border CornerRadius="10" Background="#1AFFFFFF" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#4ADE80" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="—" Foreground="White" FontFamily="{StaticResource BodySemi}" FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="VersionText" Foreground="#7F89BF" FontSize="11.5" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" Tag="dashboard" Checked="Nav_Checked" Content="{s:Tr nav.dashboard}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="scan" Checked="Nav_Checked" Content="{s:Tr nav.scan}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="protections" Checked="Nav_Checked" Content="{s:Tr nav.protections}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="quarantine" Checked="Nav_Checked" Content="{s:Tr nav.quarantine}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="check" Checked="Nav_Checked" Content="{s:Tr nav.check}" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="history" Checked="Nav_Checked" Content="{s:Tr nav.history}" />
                    <Border Height="1" Background="#22FFFFFF" Margin="10,12" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="settings" Checked="Nav_Checked" Content="{s:Tr nav.settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Custom title bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>
            <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />
        </Grid>
    </Grid>
</Window>
